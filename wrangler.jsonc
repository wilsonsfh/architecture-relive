{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "architecture-relive",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "assets": {
    "directory": "./.cloudflare/site",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "cloudflare/worker.js",
  "observability": {
    "enabled": true
  }
}
